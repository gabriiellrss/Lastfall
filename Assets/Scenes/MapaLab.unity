  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Vi um deles hoje fora da instala\xE7\xE3o.\" Parecia... normal. Roupas,
    jeito de andar, tudo igual a n\xF3s. Mas havia algo nos olhos. Uma aus\xEAncia.\nEles
    est\xE3o testando fora do laborat\xF3rio agora. Soltando-os em ambientes urbanos
    controlados.\n\nDisseram que \xE9 para medir adapta\xE7\xE3o.\n\nIsso n\xE3o
    \xE9 mais ci\xEAncia. \xC9 domestica\xE7\xE3o. E n\xF3s somos o pasto.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
