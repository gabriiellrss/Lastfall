  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Sucesso total.\" O esp\xE9cime 001 sobreviveu \xE0 fus\xE3o completa
    com o agente X-BETA. Estabilidade mental: 68%. Controle muscular e regenerativo:
    97%. Tempo de resposta neural: 2,4x superior ao padr\xE3o humano.\n\nFinalmente
    temos uma arma \u2014 ou uma cura \u2014 dependendo de quem pagar mais. A infec\xE7\xE3o,
    agora estabilizada, se torna \xFAtil. Revers\xEDvel? Talvez. Reproduz\xEDvel?
    Com certeza.\n\nIniciamos a Fase Final. Esp\xE9cimes humanos est\xE3o sendo preparados
    em 12 instala\xE7\xF5es espalhadas pelo mundo.\n\nA nova era come\xE7a aqui.
    E o mundo... n\xE3o tem ideia do que est\xE1 por vir.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
