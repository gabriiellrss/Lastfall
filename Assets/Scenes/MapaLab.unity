  pressKeyUIPrefab: {fileID: 7534970633161341705, guid: 981c7ec441bb0c24faba80768191b185, type: 3}
  interactionCanvasPrefab: {fileID: 6620540256942813620, guid: a753546d0a8c09c4592c42d3ba793801, type: 3}
  uiParent: {fileID: 1270321133}
  dialogLines:
  - "NPC: Ei, voc\xEA percebeu que a \xE1gua do rio t\xE1 diferente ultimamente?"
  - "Cleber: Notei sim... tem um cheiro estranho no ar tamb\xE9m."
  - " NPC: Dizem que a B.D. t\xE1 mexendo em coisa grande ali perto da nascente."
  - ". Cleber: \xC9... e onde a B.D. mete a m\xE3o, algo sempre muda. Pra pior."
  - " NPC: Voc\xEA acha que eles t\xEAm algo a ver com isso?"
  - "Cleber: N\xE3o posso afirmar... mas n\xE3o seria a primeira vez que um rio desaparece
    depois que eles chegam."
  - "NPC: Talvez seja s\xF3 coincid\xEAncia... n\xE9?"
  - "Cleber: Talvez. Mas eu n\xE3o confiaria minha \xFAltima gota d'\xE1gua a eles."
  interactionKey: 101
  closeKey: 27
