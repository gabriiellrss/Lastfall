  m_Name: 
  m_EditorClassIdentifier: 
  pressKeyUIPrefab: {fileID: 7534970633161341705, guid: 981c7ec441bb0c24faba80768191b185, type: 3}
  interactionCanvasPrefab: {fileID: 6620540256942813620, guid: a753546d0a8c09c4592c42d3ba793801, type: 3}
  uiParent: {fileID: 1270321133}
  dialogLines:
  - ' NPC: Um cara novo entrou hoje... chamam ele de Jeff.'
  - ". Cleber: Jeff? Nunca ouvi falar. O que ele t\xE1 fazendo aqui?"
  - " NPC: T\xE1 l\xE1 na sala de controle. Disseram que deram uma \"tarefa especial\"
    pra ele."
  - 'Cleber: Que tipo de tarefa?'
  - "NPC: Tem um bot\xE3o. Um bem grande. Ningu\xE9m toca... mas deixaram ele sozinho
    l\xE1."
  - ". Cleber: Sozinho? Com um bot\xE3o desses?"
  - "NPC: Ouvi um dos t\xE9cnicos dizer que, se ele apertar, nada mais ser\xE1 como
    antes."
  - "Cleber: Onde ele t\xE1 agora? Eu preciso achar esse tal de Jeff. Agora."
  - "NPC: Sala Leste, n\xEDvel 3. Mas voc\xEA precisa ser r\xE1pido... acho que ele
    j\xE1 t\xE1 com a m\xE3o no bot\xE3o."
  - "Cleber: Ent\xE3o espero que ele esteja pronto pra escutar... ou pra lutar."
  interactionKey: 101
  closeKey: 27
